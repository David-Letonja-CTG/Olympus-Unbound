# The game's site in the host's Caddy (D21): install.sh replaces OLYMPUS_ADDRESS with its name (e.g.
# olympus.<ip>.sslip.io, HTTPS with its own certificate) and writes this to the host's sites/. The game server serves
# everything there: the game, its API, its health check and the rooms WebSocket (Caddy upgrades WebSockets itself).
OLYMPUS_ADDRESS {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy olympus-api:8080
}
